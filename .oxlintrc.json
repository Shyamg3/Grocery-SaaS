{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/purity": "off"
  },
  "ignorePatterns": ["dist/**", "dev-dist/**", "node_modules/**"]
}
